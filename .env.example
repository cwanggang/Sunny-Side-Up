# Copy to .env.local (git-ignored) and fill in. Only EXPO_PUBLIC_* values belong here;
# they are bundled into the app, so never put the service role key or Anthropic key in this file.

# Supabase project URL and anon (publishable) key. Ask Developer B.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# true = screens use src/mocks instead of Supabase (build UI before the backend is ready).
EXPO_PUBLIC_USE_MOCKS=false

# Must match the DEMO_KEY Supabase secret. Only the hidden (dev) demo screen sends it.
EXPO_PUBLIC_DEMO_KEY=
